# ============================================
# Flask
# ============================================

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_secret_key

# ============================================
# Database
# ============================================

DATABASE_URL=postgresql://username:password@host/database
CORS_ORIGINS=https://www.clipcart.example,https://supplier.clipcart.example,https://logistics.clipcart.example,https://admin.clipcart.example

# ============================================
# JWT
# ============================================

JWT_SECRET_KEY=replace_with_a_secure_jwt_secret

# ============================================
# Razorpay
# ============================================

RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ============================================
# Cloudinary
# ============================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Email (Resend)
# ============================================

RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=your_from_email@example.com

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

CLIPCART_ADMIN_EMAIL=admin@example.com
CLIPCART_ADMIN_PORTAL_URL=https://admin.clipcart.example
ADMIN_PASSWORD_RESET_TTL=900

RAZORPAY_WEBHOOK_SECRET=Satva@31032011

# Shiprocket server-side API credentials
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret
SHIPROCKET_TIMEOUT=20
SHIPROCKET_SHIPPING_METHOD=SR
